{
  "crons": [
    {
      "path": "/api/admin/cleanup-overrides",
      "schedule": "*/5 * * * *"
    }
  ],
  "functions": {
    "api/flights/**/*": {
      "memory": 128,
      "maxDuration": 10
    },
    "api/test/**/*": {
      "memory": 128,
      "maxDuration": 5
    },
    "api/admin/**/*": {
      "memory": 256,
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=20, stale-while-revalidate=30"
        }
      ]
    },
    {
      "source": "/ver2/ver2/checkin/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=120"
        }
      ]
    },
    {
      "source": "/ver2/ver2/gate/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=120"
        }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/airlines/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, immutable"
        }
      ]
    },
    {
      "source": "/city-images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, immutable"
        }
      ]
    },
    {
      "source": "/wallpaper(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, immutable"
        }
      ]
    },
    {
      "source": "/british/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, immutable"
        }
      ]
    }
  ],
  "images": {
    "formats": ["image/webp"],
    "minimumCacheTTL": 86400,
    "sizes": [640, 750, 828, 1080, 1200, 1920, 2048, 3840]
  }
}
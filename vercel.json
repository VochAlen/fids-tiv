{
  "crons": [
    { "path": "/api/admin/cleanup-overrides", "schedule": "0 */4 * * *" },
    { "path": "/api/cron/redis-cleanup", "schedule": "0 3 * * *" }
  ],
  "headers": [
    {
      "source": "/ver2/ver2/checkin/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=120" }]
    },
    {
      "source": "/ver2/ver2/gate/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=120" }]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/airlines/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, immutable" }]
    },
    {
      "source": "/city-images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, immutable" }]
    },
    {
      "source": "/wallpaper(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, immutable" }]
    },
    {
      "source": "/british/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, immutable" }]
    }
  ],
  "images": {
    "formats": ["image/webp"],
    "minimumCacheTTL": 86400,
    "sizes": [640, 750, 828, 1080, 1200, 1920, 2048, 3840]
  }
}